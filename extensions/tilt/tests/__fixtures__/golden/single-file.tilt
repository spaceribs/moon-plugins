local_resource(
    "web:dev",
    serve_cmd = ["moon", "exec", "web:dev", "--upstream", "none", "--on-failure", "bail", "--ignore-ci-checks"],
    serve_dir = _MOON_ROOT,
    serve_env = _MOON_ENV,
    deps = [_moon_path("web/generated")],
