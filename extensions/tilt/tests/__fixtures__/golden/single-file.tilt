# Not exposed: these tasks depend on a task that runs Tilt (directly, or
# through another task listed here), so in Tilt they would start before it.
#   web:tilt-open (depends on web:tilt-up)

# Container images from each project's committed Dockerfile (`moon docker file`). The
# build sees the whole workspace, but only changes to the project and what it
# depends on trigger a rebuild. Projects not in `--to-edit` use the image as
# published. Your own Kubernetes or Compose resources deploy them by name.
# Source changes are synced into running containers (Live Update) instead of
# rebuilding, except for files that need a rebuild (manifests, lockfiles).

load("ext://restart_process", "custom_build_with_restart")

if _moon_edit("api"):
    custom_build_with_restart(
        "tilt.dev/api",
        "docker build -t $EXPECTED_REF -f api/Dockerfile .",
        deps = [_moon_path(".moon/workspace.yml"), _moon_path("api"), _moon_path("db")],
        dir = _MOON_ROOT,
        env = _MOON_ENV,
        entrypoint = ["moon", "run", "api:serve"],
        live_update = [
            fall_back_on([_moon_path(".moon/workspace.yml"), _moon_path("api/Dockerfile")]),
            sync(_moon_path("api"), "/app/api"),
            sync(_moon_path("db"), "/app/db"),
        ],
    )

if _moon_edit("web"):
    custom_build(
        "web",
        "docker build -t $EXPECTED_REF -f web/Dockerfile .",
        deps = [_moon_path(".moon/workspace.yml"), _moon_path("api"), _moon_path("api-client"), _moon_path("db"), _moon_path("tooling"), _moon_path("web")],
        ignore = [_moon_path("web/generated/**/*")],
        dir = _MOON_ROOT,
        env = _MOON_ENV,
        live_update = [
            fall_back_on([_moon_path(".moon/workspace.yml"), _moon_path("web/Dockerfile"), _moon_path("web/moon.yml"), _moon_path("web/package.json")]),
            sync(_moon_path("api"), "/app/api"),
            sync(_moon_path("api-client"), "/app/api-client"),
            sync(_moon_path("db"), "/app/db"),
            sync(_moon_path("tooling"), "/app/tooling"),
            sync(_moon_path("web"), "/app/web"),
        ],
    )

# Workloads deployed by project Tiltfiles (`project.tilt.workloads`). Tilt
# merges these with the projects' own k8s_resource/dc_resource calls, so
# nothing they set is replaced. Compose services must be loaded before this.

k8s_resource(
    "api",
    labels = ["api"],
    resource_deps = ["db:serve"],
)

dc_resource(
    "api-cache",
    labels = ["api"],
    resource_deps = ["db:serve"],
)

# Select what runs with moon project IDs (or resource names) as Tilt args.
# A project selects its resources, and Tilt adds their resource_deps:
#   tilt up -- web     tilt args -- web docs     tilt args --clear (everything)
_MOON_PROJECTS = {
    "api": ["api", "api-cache", "db:serve"],
    "api-client": ["api", "api-cache", "db:serve"],
    "db": ["db:serve"],
    "web": ["web:codegen", "web:dev", "api", "api-cache", "db:serve"],
}

_moon_enabled = []

for _moon_name in _moon_cfg.get("to-run", []):
    _moon_enabled += _MOON_PROJECTS.get(_moon_name, [_moon_name])

# Keep regenerating this file whatever is selected.
if _moon_enabled:
    _moon_enabled.append("(moon)")

config.set_enabled_resources(_moon_enabled)
