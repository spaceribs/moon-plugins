{%- import "moon/macros.tera" as moon -%}
{#- Default template for the generated Tiltfile. Custom templates can replace
    it entirely, or `{% extends "moon/Tiltfile.moon.tera" %}` and override blocks. -#}
{% block header -%}
# Code generated by tilt_extension v{{ version }} for moon. DO NOT EDIT.
# Regenerated by `moon sync` (and before `moon run`), or `moon ext tilt -- generate`.
{%- endblock header %}

{% block preamble -%}
_MOON_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), {{ root | starlark }}))

def _moon_path(path):
    return os.path.join(_MOON_ROOT, path)

# Resources run moon themselves; skip moon's workspace sync so restarts
# don't regenerate this file.
_MOON_ENV = {"MOON_SKIP_SYNC_WORKSPACE": "true"}

# Gitignored paths, which moon never hashes as task inputs.
_MOON_GITIGNORE = [
{%- for pattern in gitignore %}
    {{ pattern | moon_path }},
{%- endfor %}
]
{%- if global_gitignore and gitignore %}

# Apply them to every resource, including ones in your own Tiltfiles. Paths
# moon resources need despite being gitignored are re-included.
watch_settings(ignore = _MOON_GITIGNORE + {{ gitignore_exceptions | moon_path }})
{%- endif %}
{%- endblock preamble %}
{%- block args -%}
{%- if select_by_project %}

# Tiltfile args: moon project IDs (or resource names) to run, and which
# projects' images build from source (`--to-edit`; default all, `none` for none).
config.define_string_list("to-run", args = True, usage = "moon project IDs or Tilt resource names")
config.define_string_list("to-edit", usage = "moon project IDs whose images build from source")
_moon_cfg = config.parse()
{%- else %}

_moon_cfg = {}
{%- endif %}
_moon_to_edit = _moon_cfg.get("to-edit")

def _moon_edit(project):
    return _moon_to_edit == None or (project in _moon_to_edit and "none" not in _moon_to_edit)
{%- endblock args %}
{%- block project_tiltfiles -%}
{%- if project_tiltfiles %}

# Project Tiltfiles
{%- for path in project_tiltfiles %}
include({{ path | moon_path }})
{%- endfor %}
{%- endif %}
{%- endblock project_tiltfiles %}
{%- block moon_resource -%}
{%- if watch_config and config_files %}

# Regenerates this file when moon's configuration changes while Tilt runs.
local_resource(
    "(moon)",
    cmd = {{ regenerate_cmd | starlark }},
    dir = _MOON_ROOT,
    env = _MOON_ENV,
    deps = {{ config_files | moon_path }},
    auto_init = False,
)
{%- endif %}
{%- endblock moon_resource %}
{%- block resources -%}
{%- if resources %}

# moon tasks
{%- for resource in resources %}

{{ moon::resource(resource=resource) }}
{%- endfor %}
{%- endif %}
{%- endblock resources %}
{%- block images -%}
{%- if images %}

# Container images from moon's generated Dockerfiles (`moon docker file`). The
# build sees the whole workspace, but only changes to the project and what it
# depends on trigger a rebuild. Projects not in `--to-edit` use the image as
# published. Your own Kubernetes or Compose resources deploy them by name.
# Source changes are synced into running containers (Live Update) instead of
# rebuilding, except for files that need a rebuild (manifests, lockfiles).
{%- if restart_process %}

load("ext://restart_process", "custom_build_with_restart")
{%- endif %}
{%- for image in images %}
{%- set lu = image.live_update %}

if _moon_edit({{ image.project | starlark }}):
{%- if lu and lu.restart_entrypoint %}
    custom_build_with_restart(
{%- else %}
    custom_build(
{%- endif %}
        {{ image.image_ref | starlark }},
        {{ image.command | starlark }},
        deps = {{ image.watch | moon_path }},
{%- if image.ignore %}
        ignore = {{ image.ignore | moon_path }},
{%- endif %}
        dir = _MOON_ROOT,
        env = _MOON_ENV,
{%- if lu and lu.restart_entrypoint %}
        entrypoint = {{ lu.restart_entrypoint | starlark }},
{%- endif %}
{%- if lu %}
        live_update = [
{%- if lu.fall_back_on %}
            fall_back_on({{ lu.fall_back_on | moon_path }}),
{%- endif %}
{%- for sync in lu.syncs %}
            sync({{ sync.local | moon_path }}, {{ sync.remote | starlark }}),
{%- endfor %}
{%- if lu.restart_container %}
            restart_container(),
{%- endif %}
        ],
{%- endif %}
    )
{%- endfor %}
{%- endif %}
{%- endblock images %}
{%- block workloads -%}
{%- if workloads %}

# Workloads deployed by project Tiltfiles (`project.tilt.workloads`). Tilt
# merges these with the projects' own k8s_resource/dc_resource calls, so
# nothing they set is replaced. Compose services must be loaded before this.
{%- for workload in workloads %}

{% if workload.kind == "compose" %}dc_resource{% else %}k8s_resource{% endif %}(
    {{ workload.name | starlark }},
{%- if workload.labels %}
    labels = {{ workload.labels | starlark }},
{%- endif %}
{%- if workload.resource_deps %}
    resource_deps = {{ workload.resource_deps | starlark }},
{%- endif %}
)
{%- endfor %}
{%- endif %}
{%- endblock workloads %}
{%- block selection -%}
{%- if select_by_project %}

# Select what runs with moon project IDs (or resource names) as Tilt args.
# A project selects its resources, and Tilt adds their resource_deps:
#   tilt up -- web     tilt args -- web docs     tilt args --clear (everything)
_MOON_PROJECTS = {
{%- for project in projects %}{% if project.selection %}
    {{ project.id | starlark }}: {{ project.selection | starlark }},
{%- endif %}{% endfor %}
}

_moon_enabled = []

for _moon_name in _moon_cfg.get("to-run", []):
    _moon_enabled += _MOON_PROJECTS.get(_moon_name, [_moon_name])
{%- if watch_config and config_files %}

# Keep regenerating this file whatever is selected.
if _moon_enabled:
    _moon_enabled.append("(moon)")
{%- endif %}

config.set_enabled_resources(_moon_enabled)
{%- endif %}
{%- endblock selection %}
{% block footer %}{% endblock footer %}
