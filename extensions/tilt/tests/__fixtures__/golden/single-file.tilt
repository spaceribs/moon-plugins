def _moon_path(path):
    return os.path.join(_MOON_ROOT, path)

# Resources run moon themselves; skip moon's workspace sync so restarts
# don't regenerate this file.
_MOON_ENV = {"MOON_SKIP_SYNC_WORKSPACE": "true"}

# Gitignored paths, which moon never hashes as task inputs.
_MOON_GITIGNORE = [
    _moon_path("**/node_modules"),
    "!" + _moon_path("**/keep"),
]

# Apply them to every resource, including ones in your own Tiltfiles. Paths
# moon resources need despite being gitignored are re-included.
watch_settings(ignore = _MOON_GITIGNORE + ["!" + _moon_path(".moon/workspace.yml"), "!" + _moon_path("Tiltfile"), "!" + _moon_path("Tiltfile.moon"), "!" + _moon_path("docs/Tiltfile"), "!" + _moon_path("web/generated"), "!" + _moon_path("web/generated/**"), "!" + _moon_path("web/moon.yml")])

# Tiltfile args: moon project IDs (or resource names) to run, and which
# projects' images build from source (`--to-edit`; default all, `none` for none).
config.define_string_list("to-run", args = True, usage = "moon project IDs or Tilt resource names")
config.define_string_list("to-edit", usage = "moon project IDs whose images build from source")
_moon_cfg = dict(config.parse())

# moon ext tilt passes this to make Tilt re-apply an unchanged selection.
if "to-run" in _moon_cfg:
    _moon_cfg["to-run"] = [name for name in _moon_cfg["to-run"] if name != "(reapply)"]
_moon_to_edit = _moon_cfg.get("to-edit")

def _moon_edit(project):
    return _moon_to_edit == None or (project in _moon_to_edit and "none" not in _moon_to_edit)

# Project Tiltfiles
include(_moon_path("docs/Tiltfile"))

# Regenerates this file when moon's configuration changes while Tilt runs.
local_resource(
    "(moon)",
    cmd = ["moon", "ext", "tilt", "--", "generate"],
    dir = _MOON_ROOT,
    env = _MOON_ENV,
    deps = [_moon_path(".moon/workspace.yml"), _moon_path("web/moon.yml")],
    auto_init = False,
)

# moon tasks

local_resource(
    "db:serve",
    serve_cmd = ["moon", "exec", "db:serve", "--upstream", "none", "--on-failure", "bail", "--ignore-ci-checks"],
    serve_dir = _MOON_ROOT,
    serve_env = _MOON_ENV,
    labels = ["db"],
)

local_resource(
    "web:codegen",
    cmd = ["moon", "exec", "web:codegen", "--upstream", "none", "--on-failure", "bail", "--ignore-ci-checks"],
